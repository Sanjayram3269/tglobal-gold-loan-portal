generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model LoanScheme {
  id                  String   @id
  name                String
  interestRatePercent Decimal  @db.Decimal(5, 2)
  maxLtv              Decimal  @db.Decimal(4, 3)
  tenureMonths        Int
  repaymentType       String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  leads Lead[]
}

model Lead {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String   @db.VarChar(60)
  mobile             String   @db.VarChar(10)
  netWeightGrams     Decimal  @db.Decimal(10, 3)
  grossWeightGrams   Decimal  @db.Decimal(10, 3)
  karat              Int
  schemeId           String
  eligibleLoanRupees BigInt
  status             String   @default("SUBMITTED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  scheme LoanScheme @relation(fields: [schemeId], references: [id])

  statusHistory LeadStatusHistory[]

  @@index([mobile, createdAt])
  @@index([createdAt])
}

// Append-only audit trail: one row per status transition. Rows are only ever
// inserted (inside the same transaction as the Lead.status update), never
// updated or deleted, so history cannot be overwritten.
model LeadStatusHistory {
  id         String   @id @default(uuid()) @db.Uuid
  leadId     String   @db.Uuid
  fromStatus String   @db.VarChar(20)
  toStatus   String   @db.VarChar(20)
  createdAt  DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model IdempotencyRecord {
  key            String   @id @db.VarChar(255)
  fingerprint    String   @db.VarChar(64)
  responseStatus Int
  responseBody   String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
}